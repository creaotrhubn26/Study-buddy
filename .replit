modules = ["python-3.11"]
[deployment]
# Progress is persisted to a JSON file on local disk (see study_buddy_state.py).
# "autoscale" gives every request a fresh, ephemeral filesystem and can run
# several instances at once, which loses or splits that file. A reserved VM
# keeps one instance with durable disk. If you move back to autoscale, first
# point STUDY_BUDDY_STATE_FILE at shared storage or switch to a database.
deploymentTarget = "vm"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "libxcrypt", "pkg-config", "xsimd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8501
externalPort = 3000

[agent]
integrations = ["python_openai_ai_integrations:1.0.0"]
