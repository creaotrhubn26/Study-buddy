# Copy this file to `.streamlit/secrets.toml` for local development, or
# paste the same key/value pairs into Streamlit Community Cloud:
#   App -> Settings -> Secrets
#
# Streamlit Cloud loads these as environment variables that the app
# already reads via os.getenv().

# Default: Anthropic (Claude)
STUDY_BUDDY_AI_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-sonnet-4-6"

# Or use OpenAI instead — only set one provider block.
# STUDY_BUDDY_AI_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-..."

# Or Kimi / Moonshot
# STUDY_BUDDY_AI_PROVIDER = "kimi"
# MOONSHOT_API_KEY = "your-kimi-key"
# KIMI_BASE_URL = "https://api.moonshot.ai/v1"
# KIMI_MODEL = "kimi-k2.5"
