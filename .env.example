# Copy this file to `.env` and choose one provider block.

# Cloud setup with Anthropic (Claude)
STUDY_BUDDY_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-6        # default
# ANTHROPIC_MODEL=claude-opus-4-7          # strongest reasoning
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # cheapest / fastest
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/

# Cloud setup with OpenAI
# STUDY_BUDDY_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Free local setup with Ollama
# STUDY_BUDDY_AI_PROVIDER=ollama
# STUDY_BUDDY_AI_API_KEY=ollama
# STUDY_BUDDY_AI_BASE_URL=http://127.0.0.1:11434/v1
# STUDY_BUDDY_AI_MODEL=qwen2.5:1.5b

# Cloud setup with Kimi / Moonshot
# STUDY_BUDDY_AI_PROVIDER=kimi
# MOONSHOT_API_KEY=your_kimi_key_here
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.5
