# Copy this file to `.env` and choose one provider block.

# Free local setup with Ollama
STUDY_BUDDY_AI_PROVIDER=ollama
STUDY_BUDDY_AI_API_KEY=ollama
STUDY_BUDDY_AI_BASE_URL=http://127.0.0.1:11434/v1
STUDY_BUDDY_AI_MODEL=qwen2.5:1.5b

# Optional cloud setup with Kimi / Moonshot
# STUDY_BUDDY_AI_PROVIDER=kimi
# MOONSHOT_API_KEY=your_kimi_key_here
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.5
